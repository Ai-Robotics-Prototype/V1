    "createMultiWeld": {
        "examples": [
            "local id = 1--设置焊缝ID\ncreateMultiWeld(id,1)--将工艺模版1中的参数下发给焊缝1\nsetMultiweldRefPoints(id,{参考点1,参考点2},{焊接开始点,焊接点（起弧后第一个点位）})--通过设置参考点及焊缝点（若为圆弧则3点均填写）创建偏移坐标系\nsetMultiWeldPath(id,1,3)--设置当前焊缝1从第1道焊缝焊接至第3条焊缝，不设置则默认全部焊接\nenableMultiWeld(id)\n\n--判断当前焊接焊缝是否为第一道焊缝\nif getCurSeam(id) == 1 then--如果当前需要焊接的焊道数为1\nmovJ()--空间点\nmovL()--起弧点\narcOn()--起弧\nmovL()--焊接点\narcOff()--熄弧\nmovJ()--空间点\nend\n\n--后续焊道焊接\nwhile (not isMultiWeldFinished(id)) do--判断当前焊缝不是最后焊道\nmovJ()--空间点\nsetMultiWeldOffset(id)--下发对应焊道的焊接参数\nmovL()--起弧点\narcOn()--起弧\nweldNextSeam(id)--执行对应偏移量的轨迹\narcOff()--熄弧\nmovJ()--空间点\nend\n"
        ]
