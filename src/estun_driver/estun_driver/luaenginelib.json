    "weldMulti": {
        "lua": "weldMulti(${p1},${p2},{${pwm}},${weldmulti},${lrtrack},${tbtrack},${weldselect})\nwhile(not isMultiWeldFinished(0)) do\n$c\nend",
        "luas": "weldMulti(p1,p2,pwm,weldmulti,lrtrack,tbtrack,weldselect)",
        "luak": "weldMulti(p1,p2,pwm,weldmulti,lrtrack,tbtrack,weldselect)",
        "reps": [
            "${arcon}\nif (getCurSeam(0) ~= 1) then\nweldNextSeam(0)\nelse\n${arcmiddle}\nend\n${arcoff}\n",
            {
                "arcon": [
                    "",
                    "arcOn()",
                    [
                        [
                            "mov",
                            "setMultiWeldOffset(0)\n",
                            9999
                        ]
                    ]
                ],
                "arcmiddle": [
                    "arcOn()",
                    "arcOff()"
                ],
                "arcoff": [
                    "arcOff()",
                    ""
                ]
            }
        ],
        "vars": [
            "p1",
            "p2"
        ],
        "args": [
            "pwm"
        ],
        "examples": [
            "weldMulti(参考点1,参考点2,{起弧指令前一个点,起弧指令后一个点},工艺模版编号,左右跟踪使能,上下跟踪使能)\n\nwhile(not isMultiWeldFinished(0)) do--判断当前焊接焊道是否不是最后一道焊道\nsetMultiWeldOffset(0)--下发对应焊道的焊接参数\nmovJ()--空间点\nmovL()--起弧点\narcOn()--起弧\n\nif (getCurSeam(0) ~= 1) then--判断当前焊道是否不等于1\nweldNextSeam(0)--判断成立执行该行程序，焊接后续焊道\nelse--判断不成立执行后续程序，焊接第一道焊缝\nmovL()--焊接点\nend\n\narcOff()--熄弧\nmovJ()--空间点\nend\n\nmovJ()--空间点"
        ]
    },
